# Secrets
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
id_rsa*
mnemonic*
secrets/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
broadcast/
# lib/forge-std is tracked (copied, not a nested git submodule)
contracts/lib/**/.git/

# Node
node_modules/
frontend/dist/
frontend/.vite/
backend/dist/
backend/dist-test/
coverage/
*.tsbuildinfo

# Python (if any tooling scripts)
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Local QA / visual regression artifacts (never publish)
.qa-artifacts/
frontend/.qa-artifacts/
**/playwright-report/
**/test-results/

# Editor / OS debris already covered above; keep broadcast secrets out of tree
contracts/broadcast/**/run-latest.json

# Live deployment registries (public addresses, still environment-specific)
deployments/*.json
!deployments/*.example.json
!deployments/cc3-testnet.example.json
