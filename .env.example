# FreezeWire environment placeholders. Copy to .env locally. NEVER commit secrets.
# See docs/DEPLOYMENT_PLAN.md and config/networks.example.json.

# --- Networks ---
# Creditcoin CC3 testnet (FACT: docs.creditcoin.org endpoints, chain id 102031)
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CC3_CHAIN_ID=102031
CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# Ethereum source chain (public RPC is liveness only; not an authority)
ETH_RPC_URL=https://ethereum.publicnode.com

# --- Attestcoin (CC3 testnet, FACT: docs.attestcoin.org chains/environments) ---
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
# Optional. Public proof-by-tx worked without a key in prior observation; do not assume.
PROOF_BUILDER_API_KEY=
ATTESTCOIN_CHAIN_KEY=3
BLOCK_PROVER_ADDRESS=0x0000000000000000000000000000000000000FD2
CHAIN_INFO_ADDRESS=0x0000000000000000000000000000000000000fd3
DECODER_ADDRESS=0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f

# Canonical USDC on Ethereum mainnet (FACT: Circle FiatToken)
SOURCE_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Application freshness window (ASSUMPTION: not a protocol constant; set in deployment config)
# Inclusive source-block bounds for accepted proofs. 0 = no min/max until configured.
PROOF_MIN_HEIGHT=0
PROOF_MAX_HEIGHT=0

# --- Wallets (never commit real values) ---
DEPLOYER_PRIVATE_KEY=
RELAY_PRIVATE_KEY=

# --- Post-deploy contract addresses (empty until contracts are deployed) ---
# Prefer gitignored deployments/cc3-testnet.json (worker loads it when these are empty).
# Do not put live addresses in this example file.
# Canonical names. Aliases BLACKLIST_VERIFIER_ADDRESS / ELIGIBILITY_LEDGER_ADDRESS /
# GATED_CREDIT_LINE_ADDRESS are also accepted by the worker.
VERIFIER_ADDRESS=
LEDGER_ADDRESS=
CREDIT_LINE_ADDRESS=
MOCK_USD_ADDRESS=
# Optional aliases (same semantics as above)
BLACKLIST_VERIFIER_ADDRESS=
ELIGIBILITY_LEDGER_ADDRESS=
GATED_CREDIT_LINE_ADDRESS=
# Optional override for registry path (default: deployments/cc3-testnet.json)
# DEPLOYMENT_REGISTRY_PATH=
# Demo credit line LTV (basis points). Deploy script default 5000 = 50%.
# LTV_BPS=5000

# --- Worker / demo ---
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
LOG_LEVEL=info
# Comma-separated origins for the demo UI. Do not use * for production-style relay demos.
# Include both localhost and 127.0.0.1 — Vite may be opened on either host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret for POST /v1/relay (header X-Relay-Gate). Without it, relay is localhost-only.
RELAY_GATE=
# Gas limit multiplier applied after eth_estimateGas (default 1.2)
GAS_LIMIT_MULTIPLIER=1.2
# In-process rate limit (req/min/IP); health uses 60/min. Deployment may add edge limits.
RATE_LIMIT_PER_MIN=30

# Demo evidence (FACT re-verified 2026-09-10 via eth_getTransactionReceipt)
DEMO_SOURCE_TX=0xc9edfdbb67b48f26822d8769f63cb890599d98dec539f7f76b92edcc8a2ff787
DEMO_RESTRICTED_ACCOUNT=0xe05F529f5284D75624eBa386CB716928c3b54A2A
DEMO_SOURCE_BLOCK=25705174

# --- Frontend (Vite; also see frontend/.env.example) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_CC3_CHAIN_ID=102031
# VITE_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# VITE_CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
# VITE_CREDIT_LINE_ADDRESS=
# VITE_LEDGER_ADDRESS=
# VITE_ALLOW_SIMULATION=1

# Live test gates (never required for CI)
# LIVE_ATTESTCOIN=1
# LIVE_RELAY_BROADCAST=1
