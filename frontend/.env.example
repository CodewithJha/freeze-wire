# Frontend env (Vite). Copy values from repo `.env.example` as needed.
# Never commit secrets.

# Worker API
VITE_API_BASE_URL=http://127.0.0.1:8000

# Creditcoin CC3 testnet
VITE_CC3_CHAIN_ID=102031
VITE_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# Post-deploy. Empty until contracts are deployed — UI stays honest.
# After deploy: copy from deployments/cc3-testnet.json via `node scripts/sync-deployment-env.mjs`
VITE_CREDIT_LINE_ADDRESS=
VITE_LEDGER_ADDRESS=

# Opt-in only. Without this, missing addresses are NOT_DEPLOYED (never imply on-chain enforcement).
# VITE_ALLOW_SIMULATION=1
