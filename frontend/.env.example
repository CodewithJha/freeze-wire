# Frontend env (Vite). Copy values from repo `.env.example` as needed.
# Never commit secrets.

# Worker API (Phase 4)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Creditcoin CC3 testnet
VITE_CC3_CHAIN_ID=102031
VITE_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# Post-deploy (Phase 8). Empty until contracts are deployed — UI stays honest.
VITE_CREDIT_LINE_ADDRESS=
VITE_LEDGER_ADDRESS=
